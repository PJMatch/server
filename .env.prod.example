# Production Database Configuration
DB_USER=pjmatch_user
DB_PASSWORD=replace_with_strong_password_in_production
DB_NAME=pjmatch_prod

# Production JWT Signing Secrets (use long 64-char random strings)
JWT_ACCESS_SECRET=replace_with_strong_access_secret_64_chars_min
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_64_chars_min

# Allowed origins for CORS (your domain or VPS IP)
CORS_ALLOWED_ORIGINS=http://localhost,https://yourdomain.com

